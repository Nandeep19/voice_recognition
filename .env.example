# ---------------------------------------------------------------- database --
# PostgreSQL with the pgvector extension. Dedicated role and database, used by
# nothing else.
DATABASE_URL=postgresql://vr_app:<password>@localhost:5432/vr_dopams

# ------------------------------------------------------------- recognition --
# 1:N identify: combined speaker score needed for a match.
VOICE_THRESHOLD=0.75
# 1:1 verify against a chosen person.
PERSON_MATCH_THRESHOLD=0.75
# /search: candidates for human review.
SEARCH_THRESHOLD=0.60
# 1:N identify: best person must lead the next different person by this much.
MATCH_MARGIN=0.05
# Enrollment refuses a voice already enrolled at or above this score.
DUPLICATE_THRESHOLD=0.80
# "Add clip to speaker" requires this score against that person.
CONFIRM_THRESHOLD=0.75
# All clips of one enrollment must be this similar to each other. Measured
# on 8 real clips: same speaker >= 0.59, different speakers <= 0.48.
ENROLL_CONSISTENCY_THRESHOLD=0.53
SIGMOID_STEEPNESS=15.0

# ------------------------------------------------------------ audio gates --
MIN_SPEECH_MS=1000
ENROLLMENT_MIN_SPEECH_MS=3000
MAX_UPLOAD_MB=25
MAX_CLIP_SECONDS=180
MAX_ENROLL_CLIPS=5
VAD_THRESHOLD=0.35
VAD_MIN_SEGMENT_MS=500
VAD_PAD_MS=100
VAD_MERGE_GAP_MS=300
